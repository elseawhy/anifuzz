#!/bin/bash

nth() {
    local -a lines
    mapfile -t lines
    (( ${#lines[@]} == 0 )) && return 1
    (( ${#lines[@]} == 1 )) && printf "%s\n" "${lines[0]#*$'\t'}" && return 0
    local idx=$(printf "%s\n" "${lines[@]}" | awk -F'\t' '{ print $1 ($3 ? " " $3 : ($2 ? " " $2 : "")) }' | fuzzel -d -p "$1" --index $menu_extra_flags)
    [[ -n "$idx" && "$idx" =~ ^[0-9]+$ ]] && printf "%s\n" "${lines[idx]#*$'\t'}"
}

die() {
    notify-send "anifuzz" "$*" -i dialog-error
    exit 1
}

anidb_curl() {
    curl -sL -A "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36" --max-time 10 "$@"
}

# search the query and give results. format is (id \t name)
anidb_search() {
    _page="$(anidb_curl "https://anidb.app/browse?q=$1")"
    [[ "${_page,,}" == *"just a moment"* ]] && die "Blocked by cloudflare."
    printf "%s" "$_page" | awk -v RS='<a href' '
        /anime\/[^"]+-[0-9]+"[^>]*title="[^"]+"/ {
            id=$0;
            sub(/.*anime\//, "", id);
            sub(/".*/, "", id);
            title=$0;
            sub(/.*title="/, "", title);
            sub(/".*/, "", title);
            gsub(/&#039;/, "\047", title);
            gsub(/&quot;/, "\"", title);
            print id "\t" title;
        }
    '
}

anidb_desc() {
    seasons="$(anidb_curl "https://anidb.app/anime/$1" | awk -v RS='<a href' '
        />Seasons</ { f=1 }
        />Details</ { f=0 }
        f && /anime\/[^"]+-[0-9]+"[^>]*title="[^"]+"/ {
            id=$0;
            sub(/.*anime\//, "", id);
            sub(/".*/, "", id);
            title=$0;
            sub(/.*title="/, "", title);
            sub(/".*/, "", title);
            gsub(/&#039;/, "\047", title);
            print id "\t" title;
        }
    ')"
    [[ -n "$seasons" ]] && seasons_option="\nchange_season"
}

# get the episodes list of the selected anime. format is (id \t ep_no)
anidb_episodes() {
    anidb_curl "https://anidb.app/api/frontend/anime/${1##*-}/episodes" | awk -v RS='{' '
        /"id":[0-9]+/ && /"number":[0-9]+/ {
            id=$0;
            sub(/.*"id":/, "", id);
            sub(/[^0-9].*/, "", id);
            ep=$0;
            sub(/.*"number":/, "", ep);
            sub(/[^0-9].*/, "", ep);
            print id "\t" ep;
        }
    '
}

# extract the individual m3u8 links from response of embed urls
anidb_m3u8() {
    _ep_id=$(printf "%s" "$episode_maps" | awk -F'\t' -v ep="$1" '$2 == ep {print $1; exit}')
    _lang="jpn"
    [[ "$2" == "dub" ]] && _lang="eng"
    _embed="$(anidb_curl "https://anidb.app/api/frontend/episode/${_ep_id}/languages" | awk -v RS='{' -v lang="\"${_lang}\"" '
        $0 ~ lang && /"embed_url":"/ {
            url=$0;
            sub(/.*"embed_url":"/, "", url);
            sub(/".*/, "", url);
            gsub(/\\\//, "/", url);
            print url;
            exit;
        }
    ')"
    [[ -z "$_embed" ]] && return 1
    anidb_curl "$(anidb_curl "$_embed" | awk '
        /file: \047/ {
            url=$0;
            sub(/.*file: \047/, "", url);
            sub(/\047.*/, "", url);
            print url;
            exit;
        }
    ')" | awk '
        /#EXT-X-STREAM/ && !/I-FRAME/ {
            res=$0;
            sub(/.*x/, "", res);
            sub(/,.*/, "", res);
            getline url;
            print res "p >" url;
        }
    '
}

# gets embed url, collects direct links and selects one with desired quality into $episode
get_video_link() {
    IFS=">" read -r _ video_link < <(anidb_m3u8 "$ep_no" "$mode" | sort -g -r -s)
    [[ -z "$video_link" ]] && die "No valid sources found for $mode!"
}

update_history() {
    local tmp_hist="${histfile}.$$"
    awk -F'\t' -v ep="$ep_no" -v id="$anime_id" -v title="$anime_title" '
        BEGIN { OFS="\t"; found=0 }
        $2 == id { $1 = ep; $3 = title; found=1 }
        { print }
        END { if (!found) print ep, id, title }
    ' "$histfile" > "$tmp_hist" && mv "$tmp_hist" "$histfile" || rm -f "$tmp_hist"
}

play() {
    # In case a range (e.g. 5-10) or multi-select was passed, just grab the first episode
    ep_no="${ep_no%%[ -]*}"
    [[ -z "$ep_no" ]] && ep_no="${ep_list%%$'\n'*}"
    [[ $'\n'"$ep_list"$'\n' == *$'\n'"$ep_no"$'\n'* ]] || die "Invalid episode!"
    [[ "$log_episode" == 1 ]] && logger -t anifuzz "${anime_title} ${ep_no}" 2>/dev/null
    [[ -z "$video_link" ]] && get_video_link
    $player_function $player_extra_flags --force-media-title="${anime_title} Episode ${ep_no}" "$video_link"
    mpv_exitcode=$?
    replay="$video_link"
    unset video_link
    update_history
    [[ "$exit_after_play" == 1 ]] && exit "$mpv_exitcode"
}

# MAIN
mode="${ANI_CLI_MODE:-sub}"
log_episode="${ANI_CLI_LOG:-1}"
player_function="${ANI_CLI_PLAYER:-mpv}"
player_extra_flags="${ANI_CLI_PLAYER_FLAGS:-""}"
exit_after_play="${ANI_CLI_EXIT_AFTER_PLAY:-0}"
menu_extra_flags="${ANI_CLI_MENU_FLAGS:-"-w 70 -l 15"}"
histfile="${ANI_CLI_HIST_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/anifuzz}/ani-hsts"
mkdir -p "${histfile%/*}"
[[ ! -f "$histfile" ]] && : >"$histfile"
[[ "${1:-}" == "-c" || "${1:-}" == "--continue" ]] && source="history"

for dep in curl fuzzel "$player_function"; do
    command -v "$dep" >/dev/null || die "Program $dep not found. Please install it."
done

# searching
case "$source" in
    history)
        anime_list=$(awk -F'\t' '{printf "%s\t%s (watched ep %s)\n", $2, $3, $1}' "$histfile")
        [[ -z "$anime_list" ]] && die "History empty!"
        result=$(printf "%s" "$anime_list" | nl -w1 -s"	" | nth "Select anime: ")
        [[ -z "$result" ]] && exit 1
        anime_id="${result%%	*}"
        anime_title="${result#*	}"
        ep_no="${anime_title##*(watched ep }"
        ep_no="${ep_no%)}"
        anime_title="${anime_title% (watched ep *}"
        anidb_desc "$anime_id" || true
        episode_maps="$(anidb_episodes "$anime_id")"
        ep_list="$(printf "%s" "$episode_maps" | cut -f 2)"
        
        # Find next episode or fallback to current
        next_ep=$(printf "%s" "$ep_list" | sed -n "/^${ep_no}$/{n;p;}") 2>/dev/null
        [[ -n "$next_ep" ]] && ep_no="$next_ep"
        ;;
    *)
        [[ -z "$query" ]] && query=$(fuzzel -d --prompt-only="Search anime: " $menu_extra_flags 2>/dev/null)
        [[ -z "$query" ]] && exit 1
        query="${query// /+}"
        anime_list=$(anidb_search "$query")
        [[ -z "$anime_list" ]] && die "No results found!"
        result=$(printf "%s" "$anime_list" | nl -w1 -s"	" | nth "Select anime: ")
        [[ -z "$result" ]] && exit 1
        anime_title="${result#*	}"
        anime_id="${result%%	*}"
        anidb_desc "$anime_id" || true
        episode_maps="$(anidb_episodes "$anime_id")"
        ep_list="$(printf '%s' "$episode_maps" | cut -f 2)"
        ep_no=$(printf "%s" "$ep_list" | nth "Select episode: ")
        [[ -z "$ep_no" ]] && exit 1
        ;;
esac

# playback & loop
play

#shellcheck disable=SC2059
while cmd=$(printf "next\nreplay\nprevious\nselect$seasons_option\nquit" | nth "Playing episode $ep_no of $anime_title... "); do
    case "$cmd" in
        next) ep_no=$(printf "%s" "$ep_list" | sed -n "/^${ep_no}$/{n;p;}") 2>/dev/null ;;
        replay) video_link="$replay" ;;
        previous) ep_no=$(printf "%s" "$ep_list" | sed -n "/^${ep_no}$/{g;1!p;};h") 2>/dev/null ;;
        select) ep_no=$(printf "%s" "$ep_list" | nth "Select episode: ") ;;
        change_season)
            new_anime="$(printf "%s" "$seasons" | nl -w1 -s"	" | nth "Select season: ")"
            [[ -z "$new_anime" ]] && exit 1
            anime_title="${new_anime#*	}"
            anime_id="${new_anime%%	*}"
            anidb_desc "$anime_id" || true
            episode_maps="$(anidb_episodes "$anime_id")"
            ep_list="$(printf '%s' "$episode_maps" | cut -f 2)"
            ep_no=$(printf "%s" "$ep_list" | nth "Select episode: ")
            [[ -z "$ep_no" ]] && exit 1
            ;;
        *)
            rm -f "${histfile}.new"
            exit 0
            ;;
    esac
    [[ -z "$ep_no" ]] && die "Out of range"
    play
done

